<?xml version="1.0" encoding="utf-8"?>
<!-- Backup policy for API 31+. Mirrors backup_rules.xml: deliberate full backup of
     game history, avatars and preferences for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
